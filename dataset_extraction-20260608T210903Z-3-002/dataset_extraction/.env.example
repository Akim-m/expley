# GitHub PAT for git-mining scripts in enrich/. A classic token with
# `public_repo` scope (or fine-grained with "Public repositories: read-only")
# is sufficient — all repos we clone are public. Without this the clones
# still work but hit anonymous rate limits, especially on nomi-sec/PoC-in-GitHub.
GITHUB_TOKEN=

# Override the MongoDB connection if VRS is not on the default host/port.
# Defaults to mongodb://root:example@localhost:27017/?directConnection=true
# MONGODB_URI=
